<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Deriv Diagnostic</title>

<style>
body{
  background:#07111f;
  color:white;
  font-family:Arial;
  padding:25px;
}
.box{
  max-width:600px;
  margin:auto;
  background:#0b1928;
  padding:25px;
  border-radius:15px;
  border:1px solid #24445d;
}
h1{color:#19a7ff}
#status{color:#ffd166}
#error{
  color:#ff6572;
  margin-top:15px;
  line-height:1.5;
}
#price{
  font-size:32px;
  margin-top:20px;
}
</style>
</head>

<body>

<div class="box">

<h1>DERIV DIAGNOSTIC</h1>

<p>Status:</p>
<strong id="status">Connecting...</strong>

<div id="error"></div>

<div id="price">LIVE PRICE: ---</div>

<p>
Ticks received:
<strong id="ticks">0</strong>
</p>

</div>

<script>

let socket;

let count = 0;

const status =
document.getElementById("status");

const errorBox =
document.getElementById("error");

const price =
document.getElementById("price");

const ticks =
document.getElementById("ticks");


socket = new WebSocket(
"wss://ws.binaryws.com/websockets/v3"
);


socket.onopen = function(){

status.textContent =
"CONNECTED";

status.style.color =
"#2edb9c";

socket.send(
JSON.stringify({
ticks:"1HZ100V",
subscribe:1
})
);

};


socket.onmessage = function(event){

console.log(event.data);

const data =
JSON.parse(event.data);


if(data.error){

status.textContent =
"DERIV ERROR";

status.style.color =
"#ff6572";

errorBox.textContent =
"Exact error: " +
data.error.code +
" — " +
data.error.message;

return;

}


if(data.tick){

count++;

ticks.textContent =
count;

price.textContent =
"LIVE PRICE: " +
data.tick.quote;

status.textContent =
"TICKS RECEIVING";

status.style.color =
"#2edb9c";

}

};


socket.onerror = function(){

status.textContent =
"WEBSOCKET ERROR";

status.style.color =
"#ff6572";

errorBox.textContent =
"Browser could not establish the WebSocket connection.";

};


socket.onclose = function(){

if(count === 0){

status.textContent =
"CONNECTION CLOSED";

status.style.color =
"#ff6572";

}

};

</script>

</body>
</html>
